{
  "name": "malarka-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.ts --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-georgian": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@unhead/vue": "^2.1.17",
    "@vueuse/core": "^13.9.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "sass": "^1.108.2",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.8",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  }
}
